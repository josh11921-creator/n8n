    {
      "parameters": {
        "jsCode": "\nfunction daysAgo(n) { const d = new Date(); d.setDate(d.getDate()-n); return d; }\nfunction asDate(v) { const d = new Date(v); return isNaN(d) ? null : d; }\nconst locks = $items('Read Run Locks', 0, 0).map(i => i.json || {});\nconst dead = $items('Read Dead Letters', 0, 0).map(i => i.json || {});\nconst registry = $items('Read Cross-Channel Registry', 0, 0).map(i => i.json || {});\nconst cutoff7 = daysAgo(7);\nconst cutoff14 = daysAgo(14);\nconst configReadiness = ($('Load Central Config').first().json || {}).centralConfigReadiness || {};\n\nconst recentLocks = locks.filter(r => { const d = asDate(r.date); return d && d >= cutoff7; });\nconst recentDead = dead.filter(r => { const d = asDate(r.date); return d && d >= cutoff7; });\nconst recentPublished = registry.filter(r => { const d = asDate(r.date || r.publishedAt); return d && d >= cutoff14; });\n\nconst channelCounts = {};\nfor (const row of recentPublished) {\n  const key = row.channelName || row.channel || 'unknown';\n  channelCounts[key] = (channelCounts[key] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    workflowPackVersion: 'v23',\n    runLocksLast7d: recentLocks.length,\n    deadLettersLast7d: recentDead.length,\n    publishedLast14d: recentPublished.length,\n    publishedByChannelLast14d: channelCounts,\n    centralConfigReadiness: configReadiness,\n    deadLetterSteps: [...new Set(recentDead.map(r => r.errorStep).filter(Boolean))],\n    healthVerdict: recentDead.length > 5 ? 'Needs attention' : recentPublished.length === 0 ? 'No recent publishes detected' : 'Healthy enough to keep running',\n    nextStep: recentDead.length > 0 ? 'Check the latest dead letters and fix the repeat offender step first.' : 'No major health issues detected.'\n  }\n}];\n"
      },
